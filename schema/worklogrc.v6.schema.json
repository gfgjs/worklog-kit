{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gfgjs/worklog-kit/schema/worklogrc.v6.schema.json",
  "title": "worklog-kit 项目配置 v6(.worklogrc.jsonc)",
  "description": "当前版本。v5→v6 变更:① targetKind:none 强制 reasonRequired:true；②新增 authoritativeStatuses，显式声明哪些 status 表示当前权威，默认 active。历史 v5 配置由 worklog-kit upgrade 自动补齐。",
  "type": "object",
  "required": ["schemaVersion", "docsDir", "dirs", "status", "types", "dispositions", "authoritativeStatuses"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": {
      "type": "integer",
      "const": 6,
      "description": "配置/数据布局版本；upgrade 迁移按此逐级走。"
    },
    "lang": { "type": "string", "description": "展示面语言；MVP 仅 zh。", "default": "zh" },
    "docsDir": { "type": "string", "description": "受治理文档根目录。须为仓内相对路径。", "default": "docs" },
    "dirs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "docs 下的类型目录集合；索引门校验配置、职责表与实际目录三方一致。"
    },
    "status": {
      "type": "array",
      "items": { "type": "string" },
      "description": "活区文档 status 枚举。"
    },
    "deprecatedStatuses": {
      "type": "array",
      "items": { "type": "string" },
      "description": "标记为终态/已死的 status；不得同时声明为当前权威状态。",
      "default": ["superseded"]
    },
    "authoritativeStatuses": {
      "type": "array",
      "items": { "type": "string" },
      "description": "表示当前答案的 status 集合；必须是 status 的子集，且不得与 deprecatedStatuses 重叠。权威唯一与 STATUS 生成共用此槽位。",
      "default": ["active"]
    },
    "types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "canBeAuthoritative"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "canBeAuthoritative": { "type": "boolean", "description": "该 type 能否承载 authoritative:true。" }
        }
      }
    },
    "dispositions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["name", "targetKind", "reasonRequired"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "targetKind": { "const": "none" },
              "reasonRequired": { "const": true }
            }
          },
          {
            "type": "object",
            "required": ["name", "targetKind"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "targetKind": { "enum": ["docs", "fixed", "line-status", "frozen-ref"] },
              "target": { "type": "string" },
              "statusDir": { "type": "string" },
              "reasonRequired": { "type": "boolean" }
            }
          }
        ]
      }
    },
    "sourceRoots": {
      "description": "check-docs 代码引用扫描的源码根；缺失的显式目录允许预先声明，存在时必须为真实目录。",
      "oneOf": [
        { "const": "auto" },
        { "type": "array", "items": { "type": "string" } }
      ],
      "default": "auto"
    },
    "sourceExclude": { "type": "array", "items": { "type": "string" } },
    "profile": { "enum": ["strict", "brownfield"], "default": "strict" },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dirTableHeading": { "type": "string" },
        "archivedHeading": { "type": "string" },
        "mode": { "enum": ["invariant", "generated"], "default": "invariant" },
        "outDir": { "type": "string", "default": ".worklog/generated" }
      }
    },
    "archiveBannerMarkers": { "type": "array", "items": { "type": "string" } }
  }
}
